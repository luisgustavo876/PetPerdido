rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    // ------------------------------------------------------------------
    // Posts: leitura pública; só o autor cria, edita e apaga.
    // Outros usuários só somam +1 nos contadores ao registrar "Eu vi".
    // ------------------------------------------------------------------
    match /posts/{postId} {
      allow read: if true;
      allow create: if logado() && request.resource.data.userId == request.auth.uid;
      // O autor edita o próprio post, mas não pode trocar o dono (userId).
      allow update: if logado() && (
        (resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId)
        || registraAvistamento());
      allow delete: if logado() && resource.data.userId == request.auth.uid;

      // "Eu vi": só sightingsCount e helpersCount, exatamente +1, e no mesmo
      // batch em que o usuário cria o próprio avistamento (que ainda não existia).
      function registraAvistamento() {
        let avistamento = /databases/$(database)/documents/posts/$(postId)/sightings/$(request.auth.uid);
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['sightingsCount', 'helpersCount'])
          && request.resource.data.sightingsCount == resource.data.get('sightingsCount', 0) + 1
          && request.resource.data.helpersCount == resource.data.get('helpersCount', 0) + 1
          && !exists(avistamento)
          && existsAfter(avistamento);
      }

      // Avistamentos: o id do documento é o uid de quem viu (1 por pessoa).
      match /sightings/{uid} {
        allow read: if true;
        allow create: if logado() && uid == request.auth.uid
          && request.resource.data.userId == request.auth.uid;
        // Quem registrou ou o autor do post (ao excluir o post).
        allow delete: if logado() && (
          resource.data.userId == request.auth.uid
          || get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid);
      }
    }

    // ------------------------------------------------------------------
    // Chats: só os 2 participantes leem e escrevem na própria conversa.
    // O id é "postId_uidA_uidB" (uids em ordem) — conferido na criação.
    // ------------------------------------------------------------------
    match /chats/{chatId} {
      function participante() {
        return logado() && request.auth.uid in resource.data.participants;
      }

      // get de conversa que ainda não existe (o app confere antes de criar).
      allow get: if logado() && (resource == null || request.auth.uid in resource.data.participants);
      // list só com o filtro "participants array-contains meu uid".
      allow list: if logado() && request.auth.uid in resource.data.participants;

      // Só quem quer ajudar abre a conversa, e sempre com o AUTOR de um post
      // que existe (ninguém abre conversa com um estranho qualquer).
      function autorDoPost() {
        return get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.userId;
      }

      allow create: if logado()
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[0] < request.resource.data.participants[1]
        && chatId == request.resource.data.postId + '_'
             + request.resource.data.participants[0] + '_'
             + request.resource.data.participants[1]
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
        && autorDoPost() in request.resource.data.participants
        && autorDoPost() != request.auth.uid;

      // Só a prévia da última mensagem e os contadores de não lidas mudam.
      allow update: if participante()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage', 'lastMessageAt', 'unread']);

      allow delete: if participante();

      match /messages/{mensagemId} {
        function participanteDoChat() {
          return logado() && request.auth.uid in
            get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }
        allow read: if participanteDoChat();
        // expireAt (data de expiração, usada pela política TTL) é obrigatório.
        allow create: if participanteDoChat()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.expireAt is timestamp;
        allow delete: if participanteDoChat() && resource.data.senderId == request.auth.uid;
      }
    }

    // ------------------------------------------------------------------
    // Users: cada usuário só acessa o próprio documento (protege o CPF).
    // ------------------------------------------------------------------
    match /users/{userId} {
      allow read, write: if logado() && request.auth.uid == userId;

      // Alertas: criados só pela Cloud Function (Admin SDK, fora das regras).
      // O dono lê, apaga e marca como lida (só o campo "read").
      match /notifications/{notificacaoId} {
        allow read, delete: if logado() && request.auth.uid == userId;
        allow update: if logado() && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }

      // Pontos e resgates: o dono lê, cria e apaga (excluir conta); ninguém edita.
      // Limitação: os pontos são gravados pelo app (num produto real, por uma Function).
      match /pointsLog/{lancamentoId} {
        allow read, create, delete: if logado() && request.auth.uid == userId;
      }
      match /redemptions/{resgateId} {
        allow read, create, delete: if logado() && request.auth.uid == userId;
      }
    }
  }
}
