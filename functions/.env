# Configuração das Cloud Functions (sem segredos; a chave do Gemini fica no
# Secret Manager). Mudou algo aqui? Publique de novo:
#   firebase deploy --only functions

# Modo de teste dos alertas:
#   true  = todo post novo avisa TODOS os usuários, inclusive o autor, sem
#           olhar a distância (para testar a notificação);
#   false = normal: só quem está dentro do raio escolhido (geofencing).
ALERTAS_PARA_TODOS=true
